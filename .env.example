# Copie para .env.local no desenvolvimento. Nunca coloque valores reais neste arquivo.
# Produção e staging possuem conjuntos separados de variáveis no Coolify.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URLs públicas: use a URL exclusiva de cada ambiente.
# Produção: https://vertice.teralabs.cloud
# Staging:  https://dev.vertice.teralabs.cloud
NEXT_PUBLIC_APP_URL=

# Crons
CRON_SECRET=

# E-mail: configure SMTP completo OU Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Google Agenda
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base64 de 32 bytes. Não regenere em ambiente que já tenha conexões Google.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Ajustes opcionais do limitador MCP
MCP_RATE_LIMIT_TOKEN=120
MCP_RATE_LIMIT_IP=240
MCP_RATE_LIMIT_JANELA_SEGUNDOS=60
